# Copy to .env.local for development. Never commit real values.
# In production every variable marked "required in production" must be set;
# the app refuses to start without them (src/lib/env.ts).

# --- Database ------------------------------------------------------------
# Local: `docker compose up -d` provides this database.
DATABASE_URL="postgresql://maison:maison@localhost:5433/maison"
# Integration tests (Vitest) run against a separate database.
TEST_DATABASE_URL="postgresql://maison:maison@localhost:5433/maison_test"

# --- Site ----------------------------------------------------------------
# Public URL of the site, used for sign-in links and absolute URLs.
SITE_URL="http://localhost:3000"

# --- Admin sign-in (Better Auth, email magic link) -----------------------
# 32+ random characters: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=""
# Comma-separated addresses allowed into /admin. Nobody else can sign in.
ADMIN_EMAILS="you@example.com"

# --- Email (Resend) — required in production ------------------------------
# Without a key in development, sign-in links are printed to the terminal.
RESEND_API_KEY=""
# A verified sender on your Resend domain.
EMAIL_FROM="Maison <gallery@example.com>"

# --- Images (Cloudinary) — required in production -------------------------
# Without these in development, uploads are stored in public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder that holds this site's images in your Cloudinary account.
CLOUDINARY_FOLDER="maison"

# --- Testing a production build locally or in CI (never on the live site) ---
# LOCAL_PRODUCTION_TEST=1 lets `next start` run without Resend/Cloudinary,
# using the development fallbacks, and turns off sign-in rate limits.
# Ignored on Vercel's production deployment.
# LOCAL_PRODUCTION_TEST="1"
