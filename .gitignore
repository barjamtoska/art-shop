# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (personal)
.claude/settings.local.json

# playwright
/screenshots
/test-results
/playwright-report
/blob-report

# Prisma client (generated by `prisma generate`)
/src/generated

# Development uploads (production uses Cloudinary)
/public/uploads

# Development outbox (emails written locally when Resend is not configured)
/.dev-mail
